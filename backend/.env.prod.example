# MTM Helper 生产环境配置模板（示例，不含敏感值）
# 注意：不要提交任何真实密钥到仓库；将本文件复制为 .env.prod 并填写真实值

# 基础
SECRET_KEY=please-change-to-strong-random-key
DEBUG=false
ALLOWED_HOSTS=mtm-helper.com,www.mtm-helper.com

# 数据库（MySQL RDS）
DB_HOST=db-prod.mtm-helper.com
DB_PORT=3306
DB_NAME=mtm_helper
DB_USER=mtm_helper_prod
DB_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__
DB_CONN_MAX_AGE=120
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15
DB_USE_SSL=true
DB_SSL_CA=/etc/ssl/certs/rds-combined-ca-bundle.pem

# Redis（Cache）
REDIS_HOST=redis.mtm-helper.com
REDIS_PORT=6379
REDIS_PASSWORD=__REPLACE_WITH_STRONG_PASSWORD__
REDIS_POOL_MAX_CONNECTIONS=100
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
CACHE_DEFAULT_TTL=300
REDIS_KEY_PREFIX=mtm-helper
REDIS_ENABLE_COMPRESSION=true

# Redis 异常聚合告警参数（根据负载调整）
REDIS_ERROR_ALERT_WINDOW_SECONDS=60
REDIS_ERROR_ALERT_THRESHOLD=8
REDIS_ERROR_ALERT_COOLDOWN_SECONDS=120

# 安全与跨域（生产默认更严格）
CORS_ALLOWED_ORIGINS=https://mtm-helper.com,https://www.mtm-helper.com
CSRF_TRUSTED_ORIGINS=https://mtm-helper.com,https://www.mtm-helper.com
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
CSRF_COOKIE_HTTPONLY=true
SESSION_COOKIE_AGE=1209600

# 日志
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7

# JWT/SMS
SMS_CODE_TTL=300
SMS_RATE_LIMIT_SECONDS=60
SMS_DEV_ECHO=false
SMS_TEMPLATE_VERIFICATION=【MTM用药助手】您的验证码是 {code}，{ttl} 分钟内有效。如非本人操作，请忽略本短信。
SMS_TEMPLATE_REMINDER=【MTM用药助手】{title}：{message}

# Spug 推送（可选）
# Spug 推送配置
SPUG_PUSH_ENABLED=false
SPUG_PUSH_URL=https://push.spug.cc
SPUG_TEMPLATE_ID=
SPUG_APP_NAME=MTM用药助手
# 新增：Spug 授权令牌（如需要鉴权，留空则不携带 Authorization）
SPUG_PUSH_TOKEN=
# 新增：Spug 推送HTTP超时（秒），建议 2-5 秒
SPUG_PUSH_TIMEOUT_SECONDS=3

# Gunicorn 并发与超时（docker-compose 读取）
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60