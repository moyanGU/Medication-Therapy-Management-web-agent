# .env.example (Production template)
# 注意：此文件仅为示例模板，不要将真实密钥与口令提交到仓库。
# 复制为 .env 后，替换为你的生产参数。

# ---------------- Django 基础 ----------------
DEBUG=false
# 生产必须使用强随机值
SECRET_KEY=replace-with-a-strong-random-secret
# 逗号分隔域名/IP
ALLOWED_HOSTS=mtm-helper.com,admin.mtm-helper.com,api.mtm-helper.com

# ---------------- 跨域与 CSRF ----------------
# 逗号分隔的允许来源（协议+域名）
CORS_ALLOWED_ORIGINS=https://mtm-helper.com,https://admin.mtm-helper.com
CSRF_TRUSTED_ORIGINS=https://mtm-helper.com,https://admin.mtm-helper.com

# ---------------- 数据库（MySQL） ----------------
DB_NAME=mtm_helper
DB_USER=mtm_prod
DB_PASSWORD=your-strong-db-password
# 推荐使用内网域名
DB_HOST=db-prod.mtm-helper.com
DB_PORT=3306
# 连接持久化与超时（与部署配置保持一致）
DB_CONN_MAX_AGE=120
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15
# 启用时请提供 CA（容器内路径或挂载后路径）
DB_USE_SSL=false
DB_SSL_CA=

# ---------------- Redis 缓存 ----------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-strong-redis-password
REDIS_POOL_MAX_CONNECTIONS=100
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
CACHE_DEFAULT_TTL=300
REDIS_KEY_PREFIX=mtm-helper
# 生产默认启用 zlib 压缩（如延迟敏感或内存充足可改为 false）
REDIS_ENABLE_COMPRESSION=true

# ---------------- 安全与代理 ----------------
# 生产默认开启 HTTPS 重定向，需配合反向代理设置 X-Forwarded-Proto
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true
# Cookie 策略
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
# 会话有效期（秒，默认14天）
SESSION_COOKIE_AGE=1209600

# ---------------- 日志设置 ----------------
# 文件与控制台可独立调整级别（DEBUG/INFO/WARN/ERROR）
LOG_LEVEL=INFO
CONSOLE_LOG_LEVEL=INFO
# 单文件最大10MB、保留7个滚动文件
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=7

# ---------------- 短信/推送（如需） ----------------
# 短信验证码相关
SMS_CODE_TTL=300
SMS_RATE_LIMIT_SECONDS=60
# 生产务必关闭回显
SMS_DEV_ECHO=false
# Spug 推送平台（如启用）
SPUG_PUSH_ENABLED=false
SPUG_PUSH_URL=https://push.spug.cc
SPUG_TEMPLATE_ID=
SPUG_APP_NAME=MTM用药助手
SPUG_PUSH_TOKEN=
SPUG_PUSH_TIMEOUT_SECONDS=3

# ---------------- Web Push / VAPID ----------------
# 与前端 VITE_VAPID_PUBLIC_KEY 保持一致的公钥（Base64-URL 编码）
VAPID_PUBLIC_KEY=
# 私钥（PEM 或 Base64 DER），请妥善保管，勿提交仓库
VAPID_PRIVATE_KEY=
# 联系方式（如：mailto:admin@mtm-helper.com）
VAPID_SUBJECT=mailto:noreply@mtm-helper.com

# ---------------- Baichuan-M3（OpenAI Compatible）----------------
# 说明：后端通过 OpenAI 兼容接口调用已部署的 Baichuan-M3（例如 vLLM/sglang 的 /v1/chat/completions）
BAICHUAN_M3_ENABLED=true
# 示例：http://127.0.0.1:8001 或 http://127.0.0.1:8001/v1
BAICHUAN_M3_API_BASE_URL=
# 若你的推理服务未启用鉴权，可留空；启用鉴权则填写 Bearer Token
BAICHUAN_M3_API_KEY=
BAICHUAN_M3_MODEL=baichuan-inc/Baichuan-M3-235B
BAICHUAN_M3_TIMEOUT_SECONDS=30
BAICHUAN_M3_MAX_OUTPUT_TOKENS=1024
BAICHUAN_M3_CLASSIFIER_MAX_TOKENS=256
