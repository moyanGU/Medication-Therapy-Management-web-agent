# Django settings
DEBUG=True
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=*

# Database settings
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=mtm_helper
# 必填：生产与开发均需提供专用数据库用户（禁止使用 root）
DB_USER=
# 必填：请在本地创建 .env 文件并设置强口令，例如：DB_PASSWORD=your-strong-db-password
DB_PASSWORD=
# 推荐使用RDS内网域名
DB_HOST=db-prod.mtm-helper.com
DB_PORT=3306
# 连接持久化与超时（与 docker-compose.prod.yml 对齐）
DB_CONN_MAX_AGE=120
DB_CONNECT_TIMEOUT=5
DB_READ_TIMEOUT=15
DB_WRITE_TIMEOUT=15

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
# 请在本地创建 .env 文件并设置 REDIS_PASSWORD（如启用密码），否则留空表示无密码
REDIS_PASSWORD=

# AI服务配置
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# 短信服务配置
SMS_API_KEY=your-sms-api-key-here
SMS_SECRET=your-sms-secret-here